#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <mouse-gesture.dtsi>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
};

&trackball_listener {
    input-processors = <&zip_mouse_gesture>;
};

&zip_mouse_gesture {
    enable-eager-mode;
    suppress-movement;

    desktop_next {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(LC(RIGHT))>;
    };

    desktop_prev {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LC(LEFT))>;
    };

    task_view {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(TAB)>;
    };

    win {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LEFT_WIN>;
    };
};

&mouse_gesture_kp {
    flavor = "tap-preferred";
    tapping-term-ms = <300>;
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
        };

        parenthesises {
            bindings = <&parenthesises>;
            key-positions = <19 20>;
        };

        brackets {
            bindings = <&brackets>;
            key-positions = <7 8>;
        };

        braces {
            bindings = <&braces>;
            key-positions = <31 32>;
        };

        system_layer {
            bindings = <&mo 6>;
            key-positions = <27 28>;
            layers = <0 1>;
            timeout-ms = <50>;
        };

        bt_clr {
            bindings = <&bt BT_CLR>;
            key-positions = <5 6>;
            layers = <6>;
            timeout-ms = <50>;
        };

        bt_clr_all {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <5 9>;
            layers = <6>;
            timeout-ms = <50>;
        };

        boot {
            bindings = <&bootloader>;
            key-positions = <8 9>;
            layers = <6>;
            timeout-ms = <50>;
        };
    };

    macros {
        parenthesises: parenthesises {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N8) &kp LS(N9) &kp LEFT_ARROW>;
        };

        braces: braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(RIGHT_BRACKET) &kp LS(BACKSLASH) &kp LEFT_ARROW>;
        };

        brackets: brackets {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RIGHT_BRACKET &kp BACKSLASH &kp LEFT_ARROW>;
        };

        mo_exit_control: mo_exit_control {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_tap &tog_off 4>
                , <&macro_param_1to1 &macro_press &mo MACRO_PLACEHOLDER>
                , <&macro_pause_for_release>
                , <&macro_param_1to1 &macro_release &mo MACRO_PLACEHOLDER>
                ;
        };

        kp_exit_control: kp_exit_control {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings
                = <&macro_tap &tog_off 4>
                , <&macro_param_1to1 &macro_tap &kp MACRO_PLACEHOLDER>
                ;
        };
    };

    behaviors {
        encoder_msc_down_up: encoder_msc_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENCODER_MSC_DOWN_UP";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <20>;
        };

        tog_off: tog_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        lt_exit_control: lt_exit_control {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo_exit_control>, <&kp_exit_control>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp Q             &kp W         &kp E         &kp R     &kp T                                             &kp Y          &kp U  &kp I      &kp O    &kp P
&kp A             &kp S         &kp D         &kp F     &kp G          &none            &none        &kp H          &mouse_gesture_kp 0 J  &mouse_gesture_kp 0 K      &kp L    &kp DEL
&kp Z             &kp X         &kp C         &kp V     &kp B          &kp TAB          &none        &kp N          &kp M  &kp MINUS  &kp COMMA  &kp DOT
&kp LEFT_SHIFT    &kp LEFT_WIN     &kp LCTRL    &lt 2 LANG2    &lt 3 LANG1    &kp SPACE     &kp BACKSPACE    &kp ENTER                                  &lt 5 LALT
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        OHNISHI {
            bindings = < 
&kp Q    &kp L     &kp U    &kp DEL     &kp MINUS                            &kp F  &kp W  &kp R  &kp Y  &kp P
&kp E    &kp I     &kp A    &kp O       &kp COMMA       &none      &trans    &kp K  &kp T  &kp N  &kp S  &kp H
&kp Z    &kp X     &kp C    &kp V       &kp DOT         &trans     &trans    &kp G  &kp D  &kp M  &kp J  &kp B
&trans   &trans    &trans   &trans      &trans          &trans     &trans    &trans                      &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        NUM {
            bindings = <
&none        &kp HOME     &kp END    &none         &none                           &kp N7     &kp N8     &kp N9     &none      &none
&kp LEFT     &kp UP       &kp DOWN   &kp RIGHT     &none     &none     &none       &kp N4     &kp N5     &kp N6     &kp N0     &none
&none        &none        &none      &none         &none     &trans    &trans      &kp N1     &kp N2     &kp N3     &trans     &trans
&trans    &trans    &trans    &trans    &trans    &trans    &trans      &trans                                        &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        SYMBOL {
            bindings = <
&none    &none    &kp EQUAL            &kp LS(N7)              &kp LS(N1)                                    &none                &kp LS(COMMA)           &kp LS(DOT)     &kp INT_YEN        &none
&none    &none    &kp LS(EQUAL)        &kp LS(N2)              &kp LS(SLASH)    &none    &none            &kp SINGLE_QUOTE     &kp LS(SEMICOLON)       &kp MINUS       &kp LS(INT_YEN)    &kp BACKSPACE
&none    &none    &kp LS(INT_RO)       &kp LS(LEFT_BRACKET)    &kp LEFT_BRACKET &trans   &trans           &kp SEMICOLON        &kp LS(SINGLE_QUOTE)    &kp SLASH       &kp LS(MINUS)      &kp DEL
&trans            &trans        &trans        &trans                &trans           &trans        &trans           &trans                                                                 &trans
            >;

            sensor-bindings = <&encoder_msc_down_up>;
        };

        CONTROL {
            bindings = <
&trans    &trans     &trans     &trans     &trans                              &trans    &trans      &trans      &trans       &trans
&trans    &trans     &trans     &trans     &trans    &trans      &trans        &trans    &trans      &trans      &trans       &trans
&trans    &trans     &trans     &trans     &trans    &mkp RCLK   &trans        &trans    &trans      &trans      &trans       &trans
&trans    &trans     &trans     &lt_exit_control 2 LANG2  &lt_exit_control 3 LANG1  &mkp LCLK  &trans    &trans                                         &trans
            >;
        };

        FUNCTION {
            bindings = <
&kp F1    &kp F2     &kp F3     &kp F4     &kp F5                              &kp F6    &kp F7    &kp F8    &kp F9    &kp F10
&none     &none      &none      &none      &none     &none       &none         &none     &none     &none     &none     &kp F11
&none     &none      &none      &none      &none     &trans      &trans        &none     &none     &none     &none     &kp F12
&trans    &trans     &trans     &trans     &trans    &trans      &trans        &trans                                  &trans
            >;
        };

        SYSTEM {
            bindings = <
&none    &none    &none    &none    &none                            &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4
&to 0    &to 1    &none    &none    &none    &none      &none        &none           &none           &none           &none           &none
&none    &none    &none    &none    &none    &none      &none        &none           &none           &none           &none           &none
&none    &none    &none    &none    &none    &none      &none        &none                                                           &none
            >;
        };
    };
};
